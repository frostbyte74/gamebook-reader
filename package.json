    "test:browser": "playwright test",
    "check": "npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "vite": "^7.3.8"
  }
}
