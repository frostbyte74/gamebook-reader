{
  "name": "gamebook-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:pdfjs": "node scripts/prepare-pdfjs.js",
    "predev": "npm run prepare:pdfjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run prepare:pdfjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
